---
import Header from "../components/Header.astro";
import ui from "../data/ui.json";
import Footer from "../components/Footer.astro";
import "../styles/main.css";

const {
  lang = "fr",
  area = "main",
  pageId = "home",
  title = "Evalexa",
  description = "Site principal du projet Evalexa.",
  frHref = "/fr/",
  enHref = "/en/",
  noIndex = false,
  ogImage,
} = Astro.props;

const t = ui[lang] ?? ui.fr;

// `ogImage` can be an absolute URL or a path relative to the site root
// (e.g. the string returned by astro:assets' getImage()). Either way it
// is resolved against the production domain so social previews always
// get a fully-qualified URL, even from a local/dev build. When no
// `ogImage` is passed, no image-related meta tags are emitted at all —
// existing pages are unaffected.
const resolvedOgImage = ogImage
  ? new URL(ogImage, "https://evalexa.fr").toString()
  : undefined;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}

    {resolvedOgImage && (
      <>
        <meta property="og:type" content="website" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={resolvedOgImage} />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:image" content={resolvedOgImage} />
      </>
    )}

    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="manifest" href="/site.webmanifest" />

    <script is:inline>
      (() => {
        const savedTheme = localStorage.getItem("evalexa-theme");
        const prefersLight = window.matchMedia("(prefers-color-scheme: light)").matches;
        const theme = savedTheme || (prefersLight ? "light" : "dark");

        document.documentElement.setAttribute("data-theme", theme);
      })();
    </script>
  </head>

  <body data-area={area} data-page={pageId}>
    <a class="skip-link" href="#main">
      {t.skipToContent}
    </a>

    <Header lang={lang} frHref={frHref} enHref={enHref} />

    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <script src="../scripts/theme.js"></script>
    <script src="../scripts/language-switch.js"></script>

    <script is:inline>
      window.addEventListener("DOMContentLoaded", () => {
        if (window.EvalexaTheme) {
          window.EvalexaTheme.applyTheme(window.EvalexaTheme.getPreferredTheme());
          window.EvalexaTheme.initThemeControls();
        }
      });
    </script>
  </body>
</html>
