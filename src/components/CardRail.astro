---
import MarkdownText from "./MarkdownText.astro";

const {
  title,
  description,
  cards = [],
  previousLabel = "Précédent",
  nextLabel = "Suivant",
} = Astro.props;
---

<section class="card-rail-section" data-card-rail-section>
  <div class="card-rail-heading">
    <h2><MarkdownText tag="span" value={title} inline /></h2>
    {description && <MarkdownText value={description} />}
  </div>

  <div class="card-rail-frame">
    <button
      type="button"
      class="card-rail-arrow card-rail-arrow-prev"
      data-card-rail-prev
      aria-label={previousLabel}
    >
      <span aria-hidden="true">‹</span>
    </button>

    <div class="card-rail-track" data-card-rail-track>
      {
        cards.map((card) => (
          <a class="card-rail-card" href={card.href}>
            {card.kicker && (
              <span class="card-rail-kicker"><MarkdownText tag="span" value={card.kicker} inline /></span>
            )}

            <strong class="card-rail-title"><MarkdownText tag="span" value={card.title} inline /></strong>

            {card.description && (
              <MarkdownText tag="span" class="card-rail-description" value={card.description} />
            )}
          </a>
        ))
      }
    </div>

    <button
      type="button"
      class="card-rail-arrow card-rail-arrow-next"
      data-card-rail-next
      aria-label={nextLabel}
    >
      <span aria-hidden="true">›</span>
    </button>
  </div>
</section>

<script>
  const railSections = document.querySelectorAll("[data-card-rail-section]");

  railSections.forEach((section) => {
    const track = section.querySelector("[data-card-rail-track]");
    const previousButton = section.querySelector("[data-card-rail-prev]");
    const nextButton = section.querySelector("[data-card-rail-next]");
    const cards = Array.from(track?.querySelectorAll(".card-rail-card") ?? []);

    if (!track || !previousButton || !nextButton || cards.length === 0) return;

    let activeIndex = 0;

    const getMaxScrollLeft = () => track.scrollWidth - track.clientWidth;

    const getCenteredScrollLeft = (card) => {
      const cardCenter = card.offsetLeft + card.offsetWidth / 2;
      const trackCenter = track.clientWidth / 2;

      return cardCenter - trackCenter;
    };

    const scrollToIndex = (index) => {
      activeIndex = Math.max(0, Math.min(index, cards.length - 1));

      const targetCard = cards[activeIndex];
      const maxScrollLeft = getMaxScrollLeft();

      let targetScrollLeft;

      if (activeIndex === 0) {
        targetScrollLeft = 0;
      } else if (activeIndex === cards.length - 1) {
        targetScrollLeft = maxScrollLeft;
      } else {
        targetScrollLeft = getCenteredScrollLeft(targetCard);
      }

      track.scrollTo({
        left: Math.max(0, Math.min(targetScrollLeft, maxScrollLeft)),
        behavior: "smooth",
      });
    };

    const updateActiveIndexFromScroll = () => {
      const trackCenter = track.scrollLeft + track.clientWidth / 2;

      let closestIndex = 0;
      let closestDistance = Number.POSITIVE_INFINITY;

      cards.forEach((card, index) => {
        const cardCenter = card.offsetLeft + card.offsetWidth / 2;
        const distance = Math.abs(cardCenter - trackCenter);

        if (distance < closestDistance) {
          closestDistance = distance;
          closestIndex = index;
        }
      });

      activeIndex = closestIndex;
      updateArrowState();
    };

    const updateArrowState = () => {
      const threshold = 4;
      const maxScrollLeft = getMaxScrollLeft();

      const isAtStart = track.scrollLeft <= threshold;
      const isAtEnd = track.scrollLeft >= maxScrollLeft - threshold;

      previousButton.classList.toggle("is-muted", isAtStart);
      nextButton.classList.toggle("is-muted", isAtEnd);

      previousButton.setAttribute("aria-disabled", String(isAtStart));
      nextButton.setAttribute("aria-disabled", String(isAtEnd));
    };

    previousButton.addEventListener("click", () => {
      scrollToIndex(activeIndex - 1);
    });

    nextButton.addEventListener("click", () => {
      scrollToIndex(activeIndex + 1);
    });

    track.addEventListener("scroll", () => {
      window.requestAnimationFrame(updateActiveIndexFromScroll);
    }, { passive: true });

    window.addEventListener("resize", () => {
      scrollToIndex(activeIndex);
      updateArrowState();
    });

    scrollToIndex(0);
    updateArrowState();
  });
</script>