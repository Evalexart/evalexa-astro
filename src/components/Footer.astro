---
import navigation from "../data/navigation.json";
import ui from "../data/ui.json";
import { Image } from "astro:assets";
import logoPartialWatercolor from "../assets/images/logo/logo-partiel-watercolor.webp";

const { lang = "fr" } = Astro.props;

const t = ui[lang]?.footer ?? ui.fr.footer;
const year = new Date().getFullYear();

const footerIds = [
  "legal",
  "legal-notice",
  "privacy",
  "cgv",
  "cgu",
];

const footerItems = footerIds
  .map((id) => navigation.items.find((item) => item.id === id))
  .filter(Boolean)
  .filter((item) => item.enabled !== false);
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-brand-block">
      <Image
        class="footer-logo footer-logo-watercolor"
        src={logoPartialWatercolor}
        alt="Evalexa"
        width={96}
        loading="lazy"
      />

      <div>
        <span>© {year} Evalexa</span>
        <span class="soft-note">
          {t.scope}
        </span>
      </div>
    </div>

    <div class="footer-links">
      {
        footerItems.map((item) => (
          <a href={item.routes[lang]}>
            {item.label[lang]}
          </a>
        ))
      }
    </div>
  </div>
</footer>
