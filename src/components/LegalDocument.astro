---
import { getEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import MarkdownText from "./MarkdownText.astro";

interface Props {
  lang: "fr" | "en";
  pageId: string;
  contentId: string;
  frHref: string;
  enHref: string;
}

const { lang, pageId, contentId, frHref, enHref } = Astro.props;
const page = await getEntry("pages", contentId);
if (!page) throw new Error(`Content page not found: ${contentId}`);
const sections = page.data.legalSections ?? [];

const hubHref = lang === "fr" ? "/fr/legal/" : "/en/legal/";
const backLabel = lang === "fr" ? "Retour aux documents légaux" : "Back to legal documents";
---

<BaseLayout
  lang={lang}
  area="legal"
  pageId={pageId}
  title={page.data.title}
  description={page.data.description}
  frHref={frHref}
  enHref={enHref}
>
  <section class="hero hero-compact">
    <div class="container hero-inner narrow center">
      {page.data.eyebrow && (
        <h1 class="legal-hero-title">
          <MarkdownText tag="span" value={page.data.eyebrow} inline />
        </h1>
      )}
      {page.data.intro && <MarkdownText class="hero-text" value={page.data.intro} />}
    </div>
  </section>

  <section class="section">
    <div class="legal-layout">
      <div class="legal-document">
        {page.data.heading && (
          <h2 class="legal-document-title">
            <MarkdownText tag="span" value={page.data.heading} inline />
          </h2>
        )}
        {sections.map((section) => (
          <article class="legal-section">
            <h3>{section.title}</h3>
            <MarkdownText value={section.content} />
          </article>
        ))}
      </div>
    </div>

    <p class="center" style="margin-top: 1.6rem;">
      <a class="button" href={hubHref}>← {backLabel}</a>
    </p>
  </section>
</BaseLayout>
