---
import { getEntry, render } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Carousel from "./Carousel.astro";
import SkillIcons from "./SkillIcons.astro";
import MarkdownText from "./MarkdownText.astro";
import ui from "../data/ui.json";
import "../styles/pages/profil-pro.css";

interface Props {
  lang: "fr" | "en";
}

const { lang } = Astro.props;

const page = await getEntry("profilPro", lang);

if (!page) {
  throw new Error(`Content page not found: profil-pro/${lang}`);
}

const { Content } = await render(page);
const {
  firstName,
  lastName,
  heading,
  eyebrow,
  intro,
  quote,
  cvHref,
  photo,
  skills = [],
  skillsIntro,
  skillsSize,
  alternanceProject,
  formation = [],
  accordion = [],
  contact,
  carousel = [],
  carouselSize,
  carouselOrientation,
  carouselImageRatio,
} = page.data;
const t = ui[lang].profilePro;
const carouselLabels = ui[lang].carousel;
---

<BaseLayout
  lang={lang}
  pageId="profil-pro"
  title={page.data.title}
  description={page.data.description}
  frHref="/fr/profil-pro/"
  enHref="/en/professional-profile/"
>
  <header class="profil-header">
    <div class="profil-header-inner">
      <div class="profil-name">
        <h1>
          {firstName && lastName ? (
            <>
              <span class="prenom">{firstName}</span>
              <span class="nom">{lastName}</span>
            </>
          ) : (
            <span class="nom"><MarkdownText tag="span" value={heading} inline /></span>
          )}
        </h1>
      </div>

      {photo && (
        <div class="profil-photo">
          <Image src={photo} alt={heading} width={180} loading="eager" />
        </div>
      )}

      <div class="profil-tag">
        {eyebrow && <MarkdownText tag="p" class="eyebrow" value={eyebrow} inline />}
        {intro && <MarkdownText class="profil-tag-detail" value={intro} />}
        {cvHref && (
          <a class="profil-cv-link" href={cvHref} target="_blank" rel="noopener">
            {t.cvLabel}
          </a>
        )}
      </div>
    </div>
  </header>

  {quote && <MarkdownText tag="p" class="profil-quote" value={quote} inline />}

  {skills.length > 0 && (
    <div class="profil-page profil-skills">
      <h2 class="profil-section-title">{t.skillsTitle}</h2>
      <SkillIcons items={skills} introText={skillsIntro ?? ""} size={skillsSize} />
    </div>
  )}

  {formation.length > 0 && (
    <div class="profil-page profil-formation">
      <h2 class="profil-section-title">{t.formationTitle}</h2>
      {alternanceProject && (
        <MarkdownText class="profil-formation-project" value={alternanceProject} />
      )}
      <div class="profil-schools">
        {formation.map((school) => (
          <div class="profil-school">
            <div class="profil-school-inner">
              <span class="profil-school-name">🎓 <MarkdownText tag="span" value={school.name} inline /></span>
              {school.schedule && <div>🕔 <MarkdownText tag="span" value={school.schedule} inline /></div>}
              {school.links?.map((link) => (
                <a href={link.href} target="_blank" rel="noopener">
                  <MarkdownText tag="span" value={link.label} inline />
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  )}

  {accordion.length > 0 && (
    <div class="profil-page">
      <p class="accordion-label">{t.experienceLabel}</p>
      <div class="accordion">
        {accordion.map((entry) => (
          <details class="accordion-item">
            <summary><MarkdownText tag="span" value={entry.question} inline /></summary>
            <div class="accordion-body">
              <MarkdownText value={entry.answer} />
            </div>
          </details>
        ))}
      </div>
    </div>
  )}

  {carousel.length > 0 && (
    <div class="profil-carousel">
      <h2 class="profil-section-title">{t.carouselTitle}</h2>
      <Carousel
        items={carousel}
        size={carouselSize}
        orientation={carouselOrientation}
        imageRatio={carouselImageRatio}
        prevLabel={carouselLabels.previous}
        nextLabel={carouselLabels.next}
      />
    </div>
  )}

  {contact && (
    <div class="profil-contact">
      <div class="profil-contact-inner">
        <MarkdownText class="profil-contact-sign" value={contact.name} inline />
        <div class="profil-contact-grid">
          {contact.items.map((item) => (
            <div class="profil-contact-item">
              <span class="profil-contact-icon">{item.icon}</span>
              {item.href ? (
                <a href={item.href}><MarkdownText tag="span" value={item.label} inline /></a>
              ) : (
                <MarkdownText tag="span" value={item.label} inline />
              )}
            </div>
          ))}
        </div>
      </div>
    </div>
  )}

  <div class="content-page profil-page">
    <Content />
  </div>
</BaseLayout>
