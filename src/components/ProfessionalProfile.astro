---
import { getEntry, render } from "astro:content";
import { getImage } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Carousel from "./Carousel.astro";
import SkillIcons from "./SkillIcons.astro";
import MarkdownText from "./MarkdownText.astro";
import ProfileHeader from "./ProfileHeader.astro";
import AccordionGroups from "./AccordionGroups.astro";
import ContactCard from "./ContactCard.astro";
import ui from "../data/ui.json";
import "../styles/pages/profil-pro.css";

interface Props {
  lang: "fr" | "en";
}

const { lang } = Astro.props;

const page = await getEntry("profilPro", lang);

if (!page) {
  throw new Error(`Content page not found: profil-pro/${lang}`);
}

const { Content } = await render(page);
const {
  firstName,
  lastName,
  heading,
  eyebrow,
  intro,
  quote,
  cvHref,
  photo,
  skills = [],
  skillsIntro,
  skillsSize,
  alternanceProject,
  formation = [],
  accordion = [],
  contact,
  carousel = [],
  carouselSize,
  carouselOrientation,
  carouselImageRatio,
} = page.data;
const t = ui[lang].profilePro;
const carouselLabels = ui[lang].carousel;

// Used as the social-preview image (og:image / twitter:image) for this
// page, so a link to profil-pro shared elsewhere shows the profile photo
// instead of the first carousel image. getImage() (rather than <Image>)
// is used because the resulting URL is needed directly, ahead of render,
// to pass as a prop to BaseLayout.
const ogImage = photo
  ? (await getImage({ src: photo, width: 1200 })).src
  : undefined;
---

<BaseLayout
  lang={lang}
  pageId="profil-pro"
  title={page.data.title}
  description={page.data.description}
  frHref="/fr/profil-pro/"
  enHref="/en/professional-profile/"
  noIndex={true}
  ogImage={ogImage}
>
  <ProfileHeader
    firstName={firstName}
    lastName={lastName}
    heading={heading}
    photo={photo}
    eyebrow={eyebrow}
    intro={intro}
    cvHref={cvHref}
    cvLabel={t.cvLabel}
  />

  {quote && <MarkdownText tag="p" class="profil-quote" value={quote} inline />}

  {skills.length > 0 && (
    <div class="profil-page profil-skills">
      <h2 class="profil-section-title">{t.skillsTitle}</h2>
      <SkillIcons items={skills} introText={skillsIntro ?? ""} size={skillsSize} />
    </div>
  )}

  {carousel.length > 0 && (
    <div class="profil-carousel">
      <h2 class="profil-section-title">{t.carouselTitle}</h2>
      <Carousel
        items={carousel}
        size={carouselSize}
        orientation={carouselOrientation}
        imageRatio={carouselImageRatio}
        prevLabel={carouselLabels.previous}
        nextLabel={carouselLabels.next}
      />
    </div>
  )}

  {formation.length > 0 && (
    <div class="profil-page profil-formation">
      <h2 class="profil-section-title">{t.formationTitle}</h2>
      {alternanceProject && (
        <MarkdownText class="profil-formation-project" value={alternanceProject} />
      )}
      <div class="profil-schools">
        {formation.map((school) => (
          <div class="profil-school">
            <div class="profil-school-inner">
              <span class="profil-school-name">🎓 <MarkdownText tag="span" value={school.name} inline /></span>
              {school.schedule && <div>🕔 <MarkdownText tag="span" value={school.schedule} inline /></div>}
              {school.links?.map((link) => (
                <a href={link.href} target="_blank" rel="noopener">
                  <MarkdownText tag="span" value={link.label} inline />
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  )}

  {accordion.length > 0 && (
    <div class="profil-page">
      <AccordionGroups groups={[{ label: t.experienceLabel, items: accordion }]} />
    </div>
  )}

  {contact && (
    <div class="profil-contact">
      <ContactCard name={contact.name} blocks={contact.blocks} />
    </div>
  )}

  <div class="content-page profil-page">
    <Content />
  </div>
</BaseLayout>
