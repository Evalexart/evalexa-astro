---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import MarkdownText from "./MarkdownText.astro";

interface CarouselCard {
  image?: ImageMetadata;
  title?: string;
  description?: string;
  href?: string;
}

interface Props {
  items: CarouselCard[];
  size?: "small" | "medium" | "large";
  orientation?: "portrait" | "square" | "landscape";
  prevLabel?: string;
  nextLabel?: string;
}

const {
  items,
  size = "medium",
  orientation = "portrait",
  prevLabel = "Previous",
  nextLabel = "Next",
} = Astro.props;

const count = items.length;
// Slides: [clone of last, ...real items, clone of first] — enables the
// seamless infinite-loop illusion (see script below).
const slides = count > 1 ? [items[count - 1], ...items, items[0]] : items;
---

{count > 0 && (
  <div
    class="carousel"
    data-carousel
    data-carousel-size={size}
    data-carousel-orientation={orientation}
    data-carousel-count={count}
  >
    {count > 1 && (
      <button
        type="button"
        class="carousel-arrow carousel-arrow-prev"
        data-carousel-prev
        aria-label={prevLabel}
      >
        ‹
      </button>
    )}

    <div class="carousel-viewport" tabindex="0" role="region" aria-roledescription="carousel">
      <div class="carousel-track" data-carousel-track>
        {slides.map((card, i) => {
          const Tag = card.href ? "a" : "div";
          const isExternal = card.href?.startsWith("http://") || card.href?.startsWith("https://");
          return (
            <Tag
              class="carousel-card"
              data-carousel-card
              href={card.href}
              target={isExternal ? "_blank" : undefined}
              rel={isExternal ? "noopener noreferrer" : undefined}
              draggable="false"
              aria-hidden={count > 1 && (i === 0 || i === slides.length - 1) ? "true" : undefined}
            >
              {card.image && (
                <div class="carousel-card-image">
                  <Image src={card.image} alt={card.title ?? ""} width={640} />
                </div>
              )}
              {(card.title || card.description) && (
                <div class="carousel-card-body">
                  {card.title && <h3 class="carousel-card-title"><MarkdownText tag="span" value={card.title} inline /></h3>}
                  {card.description && (
                    <MarkdownText class="carousel-card-description" value={card.description} />
                  )}
                </div>
              )}
            </Tag>
          );
        })}
      </div>
    </div>

    {count > 1 && (
      <button
        type="button"
        class="carousel-arrow carousel-arrow-next"
        data-carousel-next
        aria-label={nextLabel}
      >
        ›
      </button>
    )}
  </div>
)}

<script>
  function initCarousel(root: HTMLElement) {
    const track = root.querySelector<HTMLElement>("[data-carousel-track]");
    const viewport = root.querySelector<HTMLElement>(".carousel-viewport");
    const prevBtn = root.querySelector<HTMLElement>("[data-carousel-prev]");
    const nextBtn = root.querySelector<HTMLElement>("[data-carousel-next]");
    const cards = Array.from(root.querySelectorAll<HTMLElement>("[data-carousel-card]"));
    const realCount = Number(root.dataset.carouselCount ?? cards.length);

    if (!track || !viewport || cards.length === 0) return;

    // Single real card, nothing to loop — leave it centered and static.
    if (realCount <= 1) return;

    let current = 1; // index 0 is the clone-of-last, real items start at 1
    let isAnimating = false;

    function cardStep() {
      const style = getComputedStyle(track!);
      const gap = parseFloat(style.columnGap || style.gap || "0");

      // offsetWidth is the layout width before scale(), unlike
      // getBoundingClientRect(), whose value changes with the active card.
      return cards[0].offsetWidth + gap;
    }

    function moveTo(index: number, animate: boolean) {
      const step = cardStep();
      const viewportWidth = viewport!.clientWidth;
      const cardWidth = cards[index].offsetWidth;
      const offset = index * step;
      const translateX = viewportWidth / 2 - cardWidth / 2 - offset;

      track!.style.transition = animate
        ? "transform 0.35s cubic-bezier(0.22, 0.61, 0.36, 1)"
        : "none";
      track!.style.transform = `translateX(${translateX}px)`;

      cards.forEach((c, i) => c.classList.toggle("is-active", i === index));
    }

    function resetTo(index: number) {
      root.classList.add("is-resetting");
      current = index;
      moveTo(current, false);

      // Keep card transitions disabled long enough for the browser to paint
      // the clone-to-real-slide reset, then restore them before interaction.
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          root.classList.remove("is-resetting");
        });
      });
    }

    let animationTimer: ReturnType<typeof setTimeout>;

    function clearAnimationLock() {
      isAnimating = false;
      clearTimeout(animationTimer);
    }

    function goTo(index: number) {
      if (isAnimating) return;
      isAnimating = true;
      current = index;
      moveTo(current, true);
      // Safety net: if transitionend never fires (e.g. the target position
      // turns out identical, so no property actually changes value), don't
      // leave the carousel permanently locked.
      clearTimeout(animationTimer);
      animationTimer = setTimeout(clearAnimationLock, 450);
    }

    function next() {
      goTo(current + 1);
    }

    function prev() {
      goTo(current - 1);
    }

    track.addEventListener("transitionend", (e) => {
      // Cards each transition their own opacity/transform (active state)
      // and those events bubble up here too — react only to the track's
      // own transform finishing, not a child card's.
      if (e.target !== track || e.propertyName !== "transform") return;

      clearAnimationLock();
      // Landed on a clone — snap invisibly to the matching real slide.
      if (current === realCount + 1) {
        resetTo(1);
      } else if (current === 0) {
        resetTo(realCount);
      }
    });

    prevBtn?.addEventListener("click", prev);
    nextBtn?.addEventListener("click", next);

    viewport.addEventListener("keydown", (e) => {
      if (e.key === "ArrowLeft") {
        e.preventDefault();
        prev();
      } else if (e.key === "ArrowRight") {
        e.preventDefault();
        next();
      }
    });

    // Touch / pointer drag
    let dragging = false;
    let dragMoved = false;
    let startX = 0;
    let baseTranslate = 0;

    function currentTranslateX() {
      const matrix = new DOMMatrixReadOnly(getComputedStyle(track!).transform);
      return matrix.m41;
    }

    viewport.addEventListener("pointerdown", (e) => {
      if (isAnimating) return;

      // Always reset the click/drag state, including when the pointer starts
      // on a linked card. Pointer capture is delayed until a real horizontal
      // drag is detected, so an ordinary click keeps its native navigation.
      dragging = true;
      dragMoved = false;
      startX = e.clientX;
      baseTranslate = currentTranslateX();
    });

    viewport.addEventListener("pointermove", (e) => {
      if (!dragging) return;
      const delta = e.clientX - startX;

      if (!dragMoved && Math.abs(delta) > 6) {
        dragMoved = true;
        track!.style.transition = "none";
        viewport.setPointerCapture(e.pointerId);
      }

      if (dragMoved) {
        track!.style.transform = `translateX(${baseTranslate + delta}px)`;
      }
    });

    function endDrag(e: PointerEvent) {
      if (!dragging) return;
      dragging = false;

      if (!dragMoved) return;

      const delta = e.clientX - startX;
      const threshold = cards[current].offsetWidth * 0.18;

      if (delta > threshold) {
        prev();
      } else if (delta < -threshold) {
        next();
      } else {
        moveTo(current, true);
      }
    }

    viewport.addEventListener("pointerup", endDrag);
    viewport.addEventListener("pointercancel", endDrag);

    // A card wrapped in <a> shouldn't navigate if the pointer actually
    // dragged the track — only treat it as a real click otherwise.
    cards.forEach((card) => {
      if (card.tagName !== "A") return;
      card.addEventListener("click", (e) => {
        if (dragMoved) {
          e.preventDefault();
          dragMoved = false;
        }
      });
    });

    let resizeTimer: ReturnType<typeof setTimeout>;
    window.addEventListener("resize", () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => moveTo(current, false), 100);
    });

    // Initial position (no animation on load).
    moveTo(current, false);
  }

  document.querySelectorAll<HTMLElement>("[data-carousel]").forEach(initCarousel);
</script>
