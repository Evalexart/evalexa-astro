---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import MarkdownText from "./MarkdownText.astro";
import { isOutboundHref } from "../lib/links";
import "../styles/components/carousel.css";

interface CarouselCard {
  image?: ImageMetadata;
  kicker?: string;
  title?: string;
  description?: string;
  href?: string;
  imageRatio?: string;
}

interface Props {
  items: CarouselCard[];
  size?: "small" | "medium" | "large";
  orientation?: "portrait" | "square" | "landscape";
  imageRatio?: string;
  prevLabel?: string;
  nextLabel?: string;
}

const {
  items,
  size = "medium",
  orientation = "portrait",
  imageRatio,
  prevLabel = "Previous",
  nextLabel = "Next",
} = Astro.props;
---

{items.length > 0 && (
  <div
    class="carousel"
    data-carousel
    data-carousel-size={size}
    data-carousel-orientation={orientation}
    data-carousel-count={items.length}
    style={imageRatio ? `--carousel-image-ratio: ${imageRatio};` : undefined}
  >
    {items.length > 1 && (
      <button type="button" class="carousel-arrow carousel-arrow-prev" data-carousel-prev aria-label={prevLabel}>‹</button>
    )}

    <div class="carousel-viewport" tabindex="0" role="region" aria-roledescription="carousel">
      <div class="carousel-track" data-carousel-track>
        {items.map((card, i) => {
          const Tag = card.href ? "a" : "div";
          // A link only opens in a new tab when it actually leads away
          // from the current page (external site or downloadable
          // document) — see isOutboundHref(). A link to another page of
          // the same site (e.g. a candidature page) stays in the same
          // tab, same as any other internal navigation.
          const outbound = isOutboundHref(card.href);
          return (
            <Tag
              class:list={["carousel-card", { "is-active": i === 0 }]}
              data-carousel-card
              data-carousel-real-index={i}
              href={card.href}
              target={outbound ? "_blank" : undefined}
              rel={outbound ? "noopener noreferrer" : undefined}
              draggable="false"
            >
              {card.image && (
                <div
                  class="carousel-card-image"
                  style={card.imageRatio ? `--carousel-image-ratio: ${card.imageRatio};` : undefined}
                >
                  <Image src={card.image} alt={card.title ?? ""} width={640} />
                </div>
              )}
              {(card.kicker || card.title || card.description) && (
                <div class="carousel-card-body">
                  {card.kicker && <p class="carousel-card-kicker"><MarkdownText tag="span" value={card.kicker} inline /></p>}
                  {card.title && (
                    <h3 class="carousel-card-title">
                      <MarkdownText tag="span" value={card.title} inline />
                      {card.href && (
                        <span class="carousel-card-title-arrow" aria-hidden="true">
                          {outbound ? "↗" : "→"}
                        </span>
                      )}
                    </h3>
                  )}
                  {card.description && <MarkdownText class="carousel-card-description" value={card.description} />}
                </div>
              )}
            </Tag>
          );
        })}
      </div>
    </div>

    {items.length > 1 && (
      <button type="button" class="carousel-arrow carousel-arrow-next" data-carousel-next aria-label={nextLabel}>›</button>
    )}
  </div>
)}

<script>
  function initCarousel(root: HTMLElement) {
    const track = root.querySelector<HTMLElement>("[data-carousel-track]");
    const viewport = root.querySelector<HTMLElement>(".carousel-viewport");
    const prevBtn = root.querySelector<HTMLElement>("[data-carousel-prev]");
    const nextBtn = root.querySelector<HTMLElement>("[data-carousel-next]");
    const realCount = Number(root.dataset.carouselCount ?? 0);

    if (!track || !viewport || realCount === 0) return;

    const sourceCards = Array.from(track.querySelectorAll<HTMLElement>("[data-carousel-card]"));
    if (realCount <= 1) {
      sourceCards[0]?.classList.add("is-active");
      return;
    }

    let cards: HTMLElement[] = [];
    let cloneCount = 0;
    let current = 0;
    let activeRealIndex = 0;
    let isAnimating = false;
    let animationTimer: ReturnType<typeof setTimeout>;
    let resizeTimer: ReturnType<typeof setTimeout>;

    const focusableSelector = "a, button, input, select, textarea, [tabindex]";

    function makeClone(sourceIndex: number) {
      const clone = sourceCards[sourceIndex].cloneNode(true) as HTMLElement;
      clone.removeAttribute("data-carousel-real-index");
      clone.dataset.carouselClone = "true";
      clone.setAttribute("aria-hidden", "true");
      if (clone.matches(focusableSelector)) clone.setAttribute("tabindex", "-1");
      clone.querySelectorAll<HTMLElement>(focusableSelector).forEach((el) => el.setAttribute("tabindex", "-1"));
      return clone;
    }

    function getGap() {
      const style = getComputedStyle(track!);
      return parseFloat(style.columnGap || style.gap || "0");
    }

    function getStep() {
      return cards[0].offsetWidth + getGap();
    }

    function requiredCloneCount() {
      const cardWidth = sourceCards[0].offsetWidth || 1;
      const step = cardWidth + getGap();
      return Math.max(realCount, Math.ceil(viewport!.clientWidth / step) + 2);
    }

    function refreshCards() {
      cards = Array.from(track!.querySelectorAll<HTMLElement>("[data-carousel-card]"));
    }

    function moveTo(index: number, animate: boolean) {
      const step = getStep();
      const cardWidth = cards[index].offsetWidth;
      const translateX = viewport!.clientWidth / 2 - cardWidth / 2 - index * step;
      track!.style.transition = animate ? "transform 0.35s cubic-bezier(0.22, 0.61, 0.36, 1)" : "none";
      track!.style.transform = `translateX(${translateX}px)`;
      cards.forEach((card, i) => card.classList.toggle("is-active", i === index));
    }

    function buildLoop(realIndex = activeRealIndex) {
      cloneCount = requiredCloneCount();
      sourceCards.forEach((card) => card.remove());
      track!.replaceChildren();

      const fragment = document.createDocumentFragment();
      for (let i = cloneCount; i > 0; i--) {
        const sourceIndex = ((realCount - (i % realCount)) % realCount);
        fragment.append(makeClone(sourceIndex));
      }
      sourceCards.forEach((card, index) => {
        card.dataset.carouselRealIndex = String(index);
        card.removeAttribute("aria-hidden");
        card.removeAttribute("tabindex");
        fragment.append(card);
      });
      for (let i = 0; i < cloneCount; i++) fragment.append(makeClone(i % realCount));

      track!.append(fragment);
      refreshCards();
      activeRealIndex = ((realIndex % realCount) + realCount) % realCount;
      current = cloneCount + activeRealIndex;
      moveTo(current, false);
    }

    function clearAnimationLock() {
      isAnimating = false;
      clearTimeout(animationTimer);
    }

    function resetTo(index: number) {
      root.classList.add("is-resetting");
      current = index;
      moveTo(current, false);
      requestAnimationFrame(() => requestAnimationFrame(() => root.classList.remove("is-resetting")));
    }

    function goTo(index: number) {
      if (isAnimating) return;
      isAnimating = true;
      current = index;
      activeRealIndex = ((current - cloneCount) % realCount + realCount) % realCount;
      moveTo(current, true);
      clearTimeout(animationTimer);
      animationTimer = setTimeout(clearAnimationLock, 450);
    }

    const next = () => goTo(current + 1);
    const prev = () => goTo(current - 1);

    buildLoop(0);

    track.addEventListener("transitionend", (event) => {
      if (event.target !== track || event.propertyName !== "transform") return;
      clearAnimationLock();
      if (current >= cloneCount + realCount) resetTo(current - realCount);
      else if (current < cloneCount) resetTo(current + realCount);
    });

    prevBtn?.addEventListener("click", prev);
    nextBtn?.addEventListener("click", next);

    // Listened on the carousel root rather than just the viewport: the
    // viewport is not an ancestor of the prev/next buttons, so a keydown
    // fired while one of those buttons is focused (e.g. right after
    // clicking it) would never have reached a listener placed on the
    // viewport alone. The root is a common ancestor of the viewport and
    // both buttons, so arrow-key navigation now works no matter which of
    // the three currently has focus.
    root.addEventListener("keydown", (event) => {
      if (event.key === "ArrowLeft") { event.preventDefault(); prev(); }
      if (event.key === "ArrowRight") { event.preventDefault(); next(); }
    });

    let dragging = false;
    let dragMoved = false;
    let startX = 0;
    let baseTranslate = 0;

    function currentTranslateX() {
      return new DOMMatrixReadOnly(getComputedStyle(track!).transform).m41;
    }

    viewport.addEventListener("pointerdown", (event) => {
      // Mouse drag isn't a meaningful interaction here (arrows + keyboard
      // already cover desktop), so it's only wired up for touch/pen —
      // where swiping is the expected gesture — and left alone for mouse.
      if (isAnimating || event.pointerType === "mouse") return;
      dragging = true;
      dragMoved = false;
      startX = event.clientX;
      baseTranslate = currentTranslateX();
    });

    viewport.addEventListener("pointermove", (event) => {
      if (!dragging) return;
      const delta = event.clientX - startX;
      if (!dragMoved && Math.abs(delta) > 6) {
        dragMoved = true;
        track!.style.transition = "none";
        viewport.setPointerCapture(event.pointerId);
      }
      if (dragMoved) track!.style.transform = `translateX(${baseTranslate + delta}px)`;
    });

    function endDrag(event: PointerEvent) {
      if (!dragging) return;
      dragging = false;
      if (!dragMoved) return;
      const delta = event.clientX - startX;
      const threshold = cards[current].offsetWidth * 0.18;
      if (delta > threshold) prev();
      else if (delta < -threshold) next();
      else {
        isAnimating = true;
        moveTo(current, true);
        clearTimeout(animationTimer);
        animationTimer = setTimeout(clearAnimationLock, 450);
      }
    }

    viewport.addEventListener("pointerup", endDrag);
    viewport.addEventListener("pointercancel", endDrag);

    track.addEventListener("click", (event) => {
      if (!dragMoved) return;
      const link = (event.target as HTMLElement).closest("a");
      if (link) event.preventDefault();
      dragMoved = false;
    });

    window.addEventListener("resize", () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => buildLoop(activeRealIndex), 120);
    });
  }

  document.querySelectorAll<HTMLElement>("[data-carousel]").forEach(initCarousel);
</script>
