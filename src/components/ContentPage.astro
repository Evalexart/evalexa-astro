---
import { getEntry, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import MarkdownText from "./MarkdownText.astro";
import LegalDocument from "./LegalDocument.astro";

const {
  lang = "fr",
  area = "main",
  pageId,
  contentId,
  frHref = "/fr/",
  enHref = "/en/",
} = Astro.props;

const page = await getEntry("pages", contentId);

if (!page) {
  throw new Error(`Content page not found: ${contentId}`);
}

const { Content } = await render(page);
---

<BaseLayout
  lang={lang}
  area={area}
  pageId={pageId}
  title={page.data.title}
  description={page.data.description}
  frHref={frHref}
  enHref={enHref}
>
  <section class="hero">
    <div class="container hero-inner narrow">
      <section class="section">
        <div class="container narrow center">
          {page.data.eyebrow && <MarkdownText tag="p" class="eyebrow" value={page.data.eyebrow} inline />}

          {page.data.heading && (
            <h1 class="hero-wordmark interactive-wordmark">
              <MarkdownText tag="span" value={page.data.heading} inline />
            </h1>
          )}

          {page.data.intro && <MarkdownText class="hero-text" value={page.data.intro} />}
        </div>
      </section>
    </div>
  </section>

  <div class="content-page">
    {page.data.legalSections?.length ? (
      <LegalDocument sections={page.data.legalSections} />
    ) : (
      <Content />
    )}
  </div>
</BaseLayout>