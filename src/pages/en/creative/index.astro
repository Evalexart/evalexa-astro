---
import { getEntry, render } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Carousel from "../../../components/Carousel.astro";
import ui from "../../../data/ui.json";

const lang = "en";
const page = await getEntry("pages", "creative/index/en");

if (!page) {
  throw new Error("Content page not found: creative/index/en");
}

const { Content } = await render(page);
const carouselLabels = ui.en.carousel;
const sections = page.data.sections ?? [];
---

<BaseLayout
  lang={lang}
  pageId="creative"
  title={page.data.title}
  description={page.data.description}
  frHref="/fr/creatif/"
  enHref="/en/creative/"
>
  <div class="showcase-container creative-page">
    <section class="hero hero-compact">
      <div class="hero-inner">
        {page.data.eyebrow && <p class="eyebrow">{page.data.eyebrow}</p>}
        <h1 class="hero-wordmark">{page.data.heading}</h1>
        {page.data.intro && <p class="hero-text">{page.data.intro}</p>}
        <Content />
      </div>
    </section>

    <div class="creative-hub">
      {
        sections.map((section) => (
          <section class="creative-carousel-section">
            <h2>{section.title}</h2>
            {section.description && <p>{section.description}</p>}
            <Carousel
              items={section.cards}
              size="medium"
              orientation="portrait"
              prevLabel={carouselLabels.previous}
              nextLabel={carouselLabels.next}
            />
          </section>
        ))
      }
    </div>
  </div>
</BaseLayout>