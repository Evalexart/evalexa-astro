---
import { getCollection } from "astro:content";
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import Gallery from "../../../../components/Gallery.astro";

const lang = "en";
const entries = await getCollection(
  "oeuvres",
  (entry) => entry.id.endsWith(`/${lang}`) && !entry.data.draft,
);

const items = entries.map((entry) => ({
  slug: entry.id.replace(`/${lang}`, ""),
  ...entry.data,
}));
---

<BaseLayout
  lang={lang}
  area="creative"
  pageId="gallery"
  title="Gallery — Visual art — Evalexa"
  description="Browse Evalexa's visual art in a filterable grid, by medium, format, series or tag."
  frHref="/fr/atelier-creatif/galerie/"
  enHref="/en/creative-workshop/gallery/"
>
  <section class="hero hero-compact">
    <div class="container hero-inner narrow center">
      <p class="eyebrow">Visual art</p>
      <h1 class="hero-wordmark">Gallery</h1>
      <p class="hero-text">
        Every artwork, filterable by medium, format, series or tag.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="showcase-container">
      <Gallery
        items={items}
        untitledLabel="Untitled"
        mediumLabel="Medium"
        formatLabel="Format"
        seriesLabel="Series"
        tagLabel="Tag"
        allLabel="All"
        orientationLabels={{ portrait: "Portrait", landscape: "Landscape", square: "Square" }}
        countTemplate="{count} artwork(s) shown"
        emptyLabel="No artwork matches these filters."
        placeholderLabel="Photo coming soon"
      />
    </div>
  </section>
</BaseLayout>
