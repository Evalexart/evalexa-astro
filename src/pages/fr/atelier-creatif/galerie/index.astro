---
import { getCollection } from "astro:content";
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import Gallery from "../../../../components/Gallery.astro";

const lang = "fr";
const entries = await getCollection(
  "oeuvres",
  (entry) => entry.id.endsWith(`/${lang}`) && !entry.data.draft,
);

const items = entries.map((entry) => ({
  slug: entry.id.replace(`/${lang}`, ""),
  ...entry.data,
}));
---

<BaseLayout
  lang={lang}
  area="creative"
  pageId="gallery"
  title="Galerie — Arts graphiques — Evalexa"
  description="Parcourir les œuvres graphiques d'Evalexa en grille filtrable, par médium, format, série ou tag."
  frHref="/fr/atelier-creatif/galerie/"
  enHref="/en/creative-workshop/gallery/"
>
  <section class="hero hero-compact">
    <div class="container hero-inner narrow center">
      <p class="eyebrow">Arts graphiques</p>
      <h1 class="hero-wordmark">Galerie</h1>
      <p class="hero-text">
        Toutes les œuvres, filtrables par médium, format, série ou tag.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="showcase-container">
      <Gallery
        items={items}
        untitledLabel="Sans titre"
        mediumLabel="Médium"
        formatLabel="Format"
        seriesLabel="Série"
        tagLabel="Tag"
        allLabel="Tous"
        orientationLabels={{ portrait: "Portrait", landscape: "Paysage", square: "Carré" }}
        countTemplate="{count} œuvre(s) affichée(s)"
        emptyLabel="Aucune œuvre ne correspond à ces filtres."
        placeholderLabel="Photo à venir"
      />
    </div>
  </section>
</BaseLayout>
