---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import "../../../../styles/components/gallery.css";

const lang = "fr";
const entries = await getCollection(
  "oeuvres",
  (entry) => entry.id.endsWith(`/${lang}`) && !entry.data.draft,
);

const seriesMap = new Map<string, { count: number; image?: (typeof entries)[number]["data"]["image"] }>();

entries.forEach((entry) => {
  const series = entry.data.series;
  if (!series) return;

  const existing = seriesMap.get(series);
  if (existing) {
    existing.count += 1;
  } else {
    seriesMap.set(series, { count: 1, image: entry.data.image });
  }
});

const seriesList = Array.from(seriesMap.entries());
---

<BaseLayout
  lang={lang}
  area="creative"
  pageId="series"
  title="Séries — Arts graphiques — Evalexa"
  description="Œuvres regroupées par période, thème, contrainte ou projet."
  frHref="/fr/atelier-creatif/series/"
  enHref="/en/creative-workshop/series/"
>
  <section class="hero hero-compact">
    <div class="container hero-inner narrow center">
      <p class="eyebrow">Arts graphiques</p>
      <h1 class="hero-wordmark">Séries</h1>
      <p class="hero-text">
        Les œuvres regroupées par période, thème, contrainte ou projet.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="showcase-container">
      {seriesList.length > 0 ? (
        <div class="gallery-series-grid">
          {seriesList.map(([series, info]) => (
            <a
              class="gallery-series-card"
              href={`/fr/atelier-creatif/galerie/?series=${encodeURIComponent(series)}`}
            >
              <div class:list={["gallery-card-visual", { "is-placeholder": !info.image }]}>
                {info.image ? (
                  <Image src={info.image} alt={series} width={480} />
                ) : (
                  <span>{series}</span>
                )}
              </div>
              <div class="gallery-series-card-body">
                <h2 class="gallery-series-card-title">{series}</h2>
                <p class="gallery-series-card-count">
                  {info.count} œuvre{info.count > 1 ? "s" : ""}
                </p>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <p class="gallery-empty">Aucune série pour le moment.</p>
      )}
    </div>
  </section>
</BaseLayout>
