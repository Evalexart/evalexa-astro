---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import statusData from "../../../../public/status/manual.json";

const labels = {
  ok: "OK",
  warning: "Attention",
  maintenance: "Maintenance",
  down: "Hors ligne",
  unknown: "Inconnu",
};

const groups = [...statusData.groups].sort((a, b) => a.order - b.order);
---

<BaseLayout
  lang="fr"
  area="atelier-numerique"
  pageId="atelier-numerique"
  title="Atelier numérique — Evalexa"
  description="Services, outils et expérimentations techniques."
  frHref="/fr/atelier-numérique/"
  enHref="/en/digital-workshop/"
>
  <section class="hero hero-compact">
    <div class="hero-text">
      <p class="eyebrow">Atelier numérique</p>
      <h1>Services, outils et expérimentations</h1>
    </div>
  </section>

  <section class="section">
    <div class="container status-hub">
      <div class="status-grid">
        {groups.map((group) => {
          const services = [...group.services].sort(
            (a, b) => a.order - b.order
          );

          return (
            <details class="status-card">
              <summary class="status-summary">
                <div class="status-main">
                  <div class="status-heading">
                    <strong>{group.title}</strong>
                  </div>
                </div>

                <div class="status-counts">
                  {Object.entries(group.counts).map(([state, count]) => (
                    <span
                      class="status-count"
                      title={labels[state]}
                      aria-label={`${labels[state]} : ${count}`}
                    >
                      <span
                        class={`mini-dot status-${state}`}
                        aria-hidden="true"
                      ></span>
                      {count}
                    </span>
                  ))}
                </div>
              </summary>

              <div class="status-services">
                {services.map((service) => (
                  <div class="status-service-row">
                    <span class="service-name">{service.name}</span>

                    <span
                      class={`mini-dot status-${service.status}`}
                      title={labels[service.status]}
                      aria-label={labels[service.status]}
                    ></span>

                    <span>{service.fresh}</span>
                  </div>
                ))}

                <a class="status-more" href={group.href}>
                  Plus d’informations →
                </a>
              </div>
            </details>
          );
        })}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .status-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    align-items: start;
  }

  @media (max-width: 760px) {
    .status-grid {
      grid-template-columns: 1fr;
    }
  }

  .status-card {
    padding: 0;
    overflow: hidden;
    border: 1px solid var(--card-border, rgba(255, 255, 255, 0.18));
    border-radius: 1rem;
    background: var(--surface);
    box-shadow: var(--shadow-soft, 0 10px 30px rgba(0, 0, 0, 0.08));
  }

  .status-summary {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 0.75rem;
    padding: 0.55rem 0.75rem;
    cursor: pointer;
    list-style: none;
  }

  .status-summary::-webkit-details-marker {
    display: none;
  }

  .status-heading {
    display: flex;
    align-items: baseline;
    gap: 0.45rem;
  }

  .status-heading strong {
    line-height: 1;
  }

  .status-counts {
    display: flex;
    gap: 0.5rem;
    font-size: 0.82rem;
  }

  .status-count {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }

  .status-services {
    display: grid;
    gap: 0.2rem;
    padding: 0 0.75rem 0.65rem;
  }

  .status-service-row {
    display: grid;
    grid-template-columns: 1fr auto 3.5rem;
    gap: 0.75rem;
    align-items: center;
    font-size: 0.84rem;
    line-height: 1.15;
    padding: 0.1rem 0;
  }

  .service-name {
    min-width: 0;
  }

  .status-service-row > .mini-dot {
    justify-self: center;
  }

  .status-more {
    margin-top: 0.25rem;
    font-size: 0.86rem;
  }

  .mini-dot {
    width: 0.48rem;
    height: 0.48rem;
    border-radius: 999px;
    flex: 0 0 auto;
  }

  .status-ok {
    background: #3ac46d;
  }

  .status-warning {
    background: #f2ab3d;
  }

  .status-maintenance {
    background: #59a8ff;
  }

  .status-down {
    background: #e25555;
  }

  .status-unknown {
    background: #9b9b9b;
  }
</style>